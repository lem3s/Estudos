<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="640.0" prefWidth="890.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FilmeController">
  <children>
    <SplitPane dividerPositions="0.55" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <items>

        <AnchorPane minHeight="0.0" minWidth="0.0">
          <children>
            <Pane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
              <children>
                <Label layoutX="310.0" layoutY="12.0" text="Cadastro de Filme">
                  <font>
                    <Font size="19.0" />
                  </font>
                </Label>

                <Label layoutX="150.0" layoutY="62.0" text="Id" />
                <TextField fx:id="idField" disable="true" editable="false" layoutX="330.0" layoutY="58.0" prefWidth="120.0" />

                <Label layoutX="150.0" layoutY="97.0" text="Título" />
                <TextField fx:id="tituloField" disable="true" layoutX="330.0" layoutY="93.0" prefWidth="330.0" />

                <Label layoutX="150.0" layoutY="132.0" text="Gênero" />
                <TextField fx:id="generoField" disable="true" layoutX="330.0" layoutY="128.0" prefWidth="230.0" />

                <Label layoutX="150.0" layoutY="167.0" text="Duração (min)" />
                <TextField fx:id="duracaoMinutosField" disable="true" layoutX="330.0" layoutY="163.0" prefWidth="120.0" />

                <Label layoutX="150.0" layoutY="202.0" text="Lançamento (dd/MM/aaaa)" />
                <TextField fx:id="dataLancamentoField" disable="true" layoutX="330.0" layoutY="198.0" prefWidth="120.0" />

                <Label layoutX="150.0" layoutY="237.0" text="Diretor" />
                <ComboBox fx:id="diretorComboBox" disable="true" layoutX="330.0" layoutY="233.0" prefWidth="330.0" />

                <Button fx:id="adicionarButton" layoutX="150.0" layoutY="282.0" mnemonicParsing="false" onAction="#onAdicionar" prefWidth="95.0" text="Adicionar" />
                <Button fx:id="atualizarButton" disable="true" layoutX="253.0" layoutY="282.0" mnemonicParsing="false" onAction="#onAtualizar" prefWidth="95.0" text="Atualizar" />
                <Button fx:id="deletarButton" disable="true" layoutX="356.0" layoutY="282.0" mnemonicParsing="false" onAction="#onDeletar" prefWidth="95.0" text="Deletar" />
                <Button fx:id="cancelarButton" disable="true" layoutX="459.0" layoutY="282.0" mnemonicParsing="false" onAction="#onCancelar" prefWidth="95.0" text="Cancelar" />
                <Button fx:id="salvarButton" disable="true" layoutX="562.0" layoutY="282.0" mnemonicParsing="false" onAction="#onSalvar" prefWidth="95.0" text="Salvar" />

                <Label fx:id="statusLabel" layoutX="150.0" layoutY="320.0" text="" />
              </children>
            </Pane>
          </children>
        </AnchorPane>

        <AnchorPane minHeight="0.0" minWidth="0.0">
          <children>
            <TableView fx:id="tabela" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
              <columns>
                <TableColumn fx:id="idCol" editable="false" prefWidth="50.0" text="Id" />
                <TableColumn fx:id="tituloCol" prefWidth="260.0" text="Título" />
                <TableColumn fx:id="generoCol" prefWidth="150.0" text="Gênero" />
                <TableColumn fx:id="duracaoMinutosCol" prefWidth="100.0" text="Duração (min)" />
                <TableColumn fx:id="dataLancamentoCol" prefWidth="110.0" text="Lançamento" />
                <TableColumn fx:id="diretorCol" prefWidth="200.0" text="Diretor" />
              </columns>
            </TableView>
          </children>
        </AnchorPane>

      </items>
    </SplitPane>
  </children>
</AnchorPane>
